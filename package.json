{
  "name": "virtual-trading-simulator",
  "version": "1.0.0",
  "type": "module",
  "description": "A virtual trading simulator for learning and practicing stock trading",
  "main": "backend/server.js",
  "scripts": {
    "start": "NODE_ENV=production node backend/server.js",
    "dev": "nodemon backend/server.js",
    "dev:lowres": "NODE_OPTIONS=\"--max-old-space-size=1024\" REALTIME_UPDATE_INTERVAL=10000 MAX_ACTIVE_SYMBOLS=20 nodemon backend/server.js",
    "start:prod": "NODE_ENV=production NODE_OPTIONS=\"--max-old-space-size=1024\" node backend/server.js",
    "test": "NODE_OPTIONS=\"--experimental-vm-modules\" jest",
    "build": "cd frontend && npm install && npm run build && cd .. && npm run load-stocks",
    "load-stocks": "node backend/scripts/loadAllIndianStocks.js",
    "lint": "eslint .",
    "setup-mongodb-atlas": "node scripts/setup-mongodb-atlas.js",
    "realtime-updates": "node scripts/realtime-updates.js",
    "connect-mongodb": "node scripts/connect-mongodb-atlas.js",
    "fix-indexes": "node scripts/fix-index-conflicts.js",
    "fix-db-connection": "node scripts/fix-db-connection.js",
    "setup-realtime-data": "node scripts/setup-realtime-data.js",
    "monitor-db": "node scripts/monitor-realtime-updates.js"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "axios": "^1.3.4",
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.2.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "colors": "^1.4.0",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-async-handler": "^1.2.0",
    "express-rate-limit": "^6.11.2",
    "express-session": "^1.18.1",
    "express-validator": "^7.0.1",
    "helmet": "^6.2.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.6.0",
    "jsonwebtoken": "^9.0.0",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "mongodb": "^6.15.0",
    "mongoose": "^8.13.0",
    "node-cache": "^5.1.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.10.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "razorpay": "^2.9.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.10.0",
    "socket.io": "^4.8.1",
    "winston": "^3.17.0",
    "ws": "^8.13.0",
    "xss-clean": "^0.1.4",
    "yahoo-finance2": "^2.3.10"
  },
  "devDependencies": {
    "@babel/core": "^7.21.4",
    "@babel/preset-env": "^7.21.4",
    "@babel/preset-react": "^7.18.6",
    "eslint": "^8.38.0",
    "jest": "^29.5.0",
    "nodemon": "^2.0.22",
    "prettier": "^2.8.7"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
