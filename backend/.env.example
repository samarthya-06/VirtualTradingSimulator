# Environment Configuration

# Server settings
PORT=5002
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/virtual_trading_simulator

# Security
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRY=7d
PASSWORD_SALT_ROUNDS=10

# Redis Cache (optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
USE_REDIS=false

# Yahoo Finance API
YAHOO_FINANCE_API_KEY=

# News API
NEWS_API_KEY=your_news_api_key_here

# Indian Market Data API
INDIAN_MARKET_API_URL=https://api.example.com/v1/market
INDIAN_MARKET_API_KEY=your_api_key_here

# Payment Gateway Settings
RAZORPAY_KEY_ID=rzp_test_I0ZXGtdTY1OtZT
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=your_smtp_password
EMAIL_FROM=noreply@example.com

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Feature Flags
ENABLE_PAPER_TRADING=true
ENABLE_REAL_TRADING=false

# API Rate Limits
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# System Performance
MEMORY_LIMIT_MB=2048